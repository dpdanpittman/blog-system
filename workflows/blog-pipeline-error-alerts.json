    {
      "executeOnce": true,
      "id": "Skip Repeats",
      "name": "Skip Repeats",
      "parameters": {
        "jsCode": "const d = $('Decide Retry').first().json;\nconst row = $('Get Last Alert').all().map(i => i.json).find(r => r && r.key === 'last_alert') || {};\nlet last = {}; try { last = JSON.parse(row.value || '{}'); } catch (e) {}\nconst repeat = last.key === d.dedupeKey && Date.now() - (last.at || 0) < 3600e3;\nif (repeat) console.log('Same alert sent within the hour; not sending again:', d.dedupeKey);\nreturn [{ json: { ...d, send: !repeat, stateValue: JSON.stringify({ key: d.dedupeKey, at: Date.now() }) } }];\n"
