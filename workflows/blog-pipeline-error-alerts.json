    {
      "executeOnce": true,
      "id": "Decide Retry",
      "name": "Decide Retry",
      "parameters": {
        "jsCode": "// The failed run is the blog_runs row whose last_exec is the failing execution's id (each agent writes it when it starts).\n// No row (e.g. the digest, or Agent 1 failing before it records the run) = no run to blame; nothing is guessed.\nconst s = $('Summarize Failure').first().json;\nconst now = $now.setZone('UTC'), today = now.toISODate();\nconst run = s.executionId ? ($('Find Failed Run').all().map(i => i.json).find(r => r && r.run_id && String(r.last_exec) === s.executionId) || null) : null;\nconst mode = run ? run.mode : (s.isAgent1 && s.mode === 'trigger' ? 'scheduled' : (s.mode || 'unknown'));\nconst dry = run ? (run.dry_run === true || run.dry_run === 'true') : s.testMarked;\nconst published = !!run && run.status === 'published';     // e.g. the announcement failed after the post went out\nconst seen = new Set();\nconst retriesToday = $('Get Today\\'s Runs').all().map(i => i.json)\n  .filter(r => r && r.run_id && !seen.has(r.run_id) && seen.add(r.run_id))\n  .filter(r => r.mode === 'retry' && r.day === today && ((r.dry_run === true || r.dry_run === 'true') === dry)).length;\nconst MAX = 2;\nconst retryable = s.isPipeline && !published && ['scheduled', 'retry'].includes(mode);\nconst retry = retryable && retriesToday < MAX;\nconst waitSeconds = dry ? 60 : 1800;                 // test runs retry after 1 min, real ones after 30 min\nconst at = now.plus({ seconds: waitSeconds }).toFormat('h:mm a');\nconst queueId = run ? Number(run.queue_id) || 0 : 0;\n// Queue: a queued topic whose run failed and will not be retried is marked 'failed' (a retry carries the queueId and picks it up again).\nconst queueFail = !!queueId && !retry && !published;\nconst held = /^Post held/.test(s.msg);\nlet tail = '';\nif (published) tail = ' The post itself is live.';\nelse if (retryable) tail = retry ? ` Retrying at ${at} (${retriesToday + 1} of ${MAX} today).` : ' No retries left today.';\nif (queueFail) tail += ` Queued topic #${queueId} marked failed${dry ? ' (test: not written)' : ''}.`;\nlet text = `${dry ? '[test] ' : ''}Blog ${s.short} failed at \"${s.step}\": ${s.msg}`;\ntext = text.slice(0, 300 - tail.length) + tail;\nconst newRunId = 'run-' + now.toFormat('yyyyLLdd-HHmmss') + '-retry';\n// Dedupe: pipeline failures alert once PER EXECUTION (so a retry that fails the same way still alerts);\n// other workflows (inbox, ham, digest) send the same alert at most once an hour.\nconst dedupeKey = s.isPipeline ? ('exec:' + s.executionId) : (s.wf + '|' + s.step + '|' + s.msg.slice(0, 80));\nconsole.log('Decide:', JSON.stringify({ run: run && run.run_id, mode, dry, published, retriesToday, retry, queueId, queueFail, held }));\nreturn [{ json: { text, retry, waitSeconds, dry, hasRun: !!run && !published, runId: run ? run.run_id : '', queueId, queueFail,\n  writeQueueId: queueFail && !dry ? queueId : -1, runStatus: held ? 'held' : 'failed',\n  forceFail: run ? (run.force_fail || '') : '', newRunId, day: today, msg: s.msg, dedupeKey } }];\n"
      },
      "position": [
        680,
        100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
