    {
      "parameters": {
        "jsCode": "const cmdData = $(\"Parse Command\").first().json;\nconst response = $input.first().json;\n\nlet posts = [];\nif (response.posts) {\n  posts = response.posts;\n} else if (Array.isArray(response)) {\n  posts = response;\n}\n\nlet message = '📝 *Recent Blog Posts*\\n\\n';\n\nif (posts.length === 0) {\n  message += 'No posts found.';\n} else {\n  posts.slice(0, 10).forEach((post, i) => {\n    const title = post.title?.substring(0, 50) || 'Untitled';\n    const date = post.date || post.createdAt?.split('T')[0] || 'Unknown';\n    const slug = post.slug || '';\n    message += `${i + 1}. *${title}*\\n`;\n    message += `   📅 ${date}\\n`;\n    if (slug) {\n      message += `   🔗 https://mabus.ai/blog/${slug}\\n`;\n    }\n    message += '\\n';\n  });\n}\n\nreturn [{\n  json: {\n    chatId: cmdData.chatId,\n    message: message\n  }\n}];"
      },
