    {
      "parameters": {
        "jsCode": "const message = $input.first().json.message || {};\nconst text = message.text || '';\nconst chatId = message.chat?.id?.toString() || '';\nconst userId = message.from?.id?.toString() || '';\nconst username = message.from?.username || 'unknown';\n\n// SECURITY: Only allow specific user ID\nconst ALLOWED_USER_ID = '551663660';\n\nif (userId !== ALLOWED_USER_ID) {\n  console.log('🚫 Blog Bot: Unauthorized user:', userId, username);\n  return [{\n    json: {\n      command: 'unauthorized',\n      chatId: chatId,\n      userId: userId\n    }\n  }];\n}\n\n// Parse command and arguments\nlet command = '';\nlet subCommand = '';\nlet args = '';\n\nif (text.startsWith('/')) {\n  const parts = text.slice(1).split(/\\s+/);\n  command = parts[0]?.toLowerCase() || '';\n  \n  // Handle /topic run|queue <subject>\n  if (command === 'topic' && parts.length >= 2) {\n    subCommand = parts[1]?.toLowerCase() || '';\n    args = parts.slice(2).join(' ');\n  } else {\n    args = parts.slice(1).join(' ');\n  }\n}\n\nconsole.log('📱 Blog Bot: Received command:', command, 'subCommand:', subCommand, 'args:', args);\n\nreturn [{\n  json: {\n    command: command,\n    subCommand: subCommand,\n    args: args,\n    chatId: chatId,\n    userId: userId,\n    username: username,\n    rawText: text\n  }\n}];"
      },
      "id": "parse-command",
      "name": "Parse Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
