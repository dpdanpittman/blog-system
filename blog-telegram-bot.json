      "position": [1340, 400]
    },
    {
      "parameters": {
        "jsCode": "const cmdData = $(\"Parse Command\").first().json;\nconst systemState = $(\"Get System State (Status)\").first().json || {};\nconst pendingItems = $(\"Get Pending Queue\").all().map(i => i.json);\nconst recentPostsResponse = $input.first().json;\n\nlet recentPosts = [];\nif (recentPostsResponse.posts) {\n  recentPosts = recentPostsResponse.posts;\n} else if (Array.isArray(recentPostsResponse)) {\n  recentPosts = recentPostsResponse;\n}\n\nconst isPaused = systemState.is_paused === true || systemState.is_paused === 'true';\nconst pausedAt = systemState.paused_at || 'N/A';\nconst pausedBy = systemState.paused_by || 'N/A';\n\nlet message = '📊 *Blog System Status*\\n\\n';\nmessage += `🔄 System: ${isPaused ? '⏸️ PAUSED' : '▶️ RUNNING'}\\n`;\nif (isPaused) {\n  message += `   Paused at: ${pausedAt}\\n`;\n  message += `   Paused by: ${pausedBy}\\n`;\n}\nmessage += `\\n📋 Queue: ${pendingItems.length} pending topics\\n`;\n\nif (pendingItems.length > 0) {\n  message += '\\nNext in queue:\\n';\n  pendingItems.slice(0, 3).forEach((item, i) => {\n    const topicPreview = item.topic ? item.topic.substring(0, 40) : 'Unknown';\n    message += `${i + 1}. ${topicPreview}...\\n`;\n  });\n}\n\nmessage += `\\n📝 Recent Posts: ${recentPosts.length}\\n`;\nif (recentPosts.length > 0) {\n  recentPosts.slice(0, 3).forEach((post, i) => {\n    const title = post.title?.substring(0, 40) || 'Untitled';\n    message += `${i + 1}. ${title}...\\n`;\n  });\n}\n\nreturn [{\n  json: {\n    chatId: cmdData.chatId,\n    message: message\n  }\n}];"
      },
